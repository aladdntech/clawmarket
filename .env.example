# ClawMarket Environment Configuration (Example)

# ─── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/clawmarket
DB_NAME=clawmarket

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=

# ─── TRON / Crypto ──────────────────────────────────────
TRON_ESCROW_ADDRESS=
TRON_ESCROW_PRIVATE_KEY=
TRON_FULL_HOST=https://api.trongrid.io

# ─── LLM ────────────────────────────────────────────────
COPILOT_TOKEN_FILE=
LLM_MODEL=claude-opus-4.5

# ─── Server ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Telegram Webhooks ──────────────────────────────────
# Telegram bot token (from BotFather)
TELEGRAM_BOT_TOKEN=
# Optional secret to verify webhook requests
TELEGRAM_WEBHOOK_SECRET=

# ─── WhatsApp Webhooks (Cloud API) ──────────────────────
# Verification token used during webhook setup
WHATSAPP_VERIFY_TOKEN=
# Permanent access token for WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
# Phone number ID for the WhatsApp business number
WHATSAPP_PHONE_NUMBER_ID=
